# Used by docker compose and for running the API / tests on the host.
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow
POSTGRES_DB=ledgerflow
POSTGRES_PORT=5433
API_PORT=8080

# Host-run API (go run ./cmd/api)
DATABASE_URL=postgres://ledgerflow:ledgerflow@localhost:5433/ledgerflow?sslmode=disable
# Loopback only. Use :8080 only if you deliberately want all interfaces.
HTTP_ADDR=127.0.0.1:8080
AUTO_MIGRATE=true
# Development-only /dev/* routes (create users/accounts, outbox inspection, reconciliation).
# They are UNAUTHENTICATED and expose data for every account. Off by default; set to true
# only for a local demo, and never on a network you do not control.
DEV_ENDPOINTS=false

# Integration tests (use a separate database)
TEST_DATABASE_URL=postgres://ledgerflow:ledgerflow@localhost:5433/ledgerflow_test?sslmode=disable
